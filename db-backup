#!/usr/bin/env bash
# db-backup — stream database backups directly to object storage via rclone.
#
# Each database is dumped, gzipped, and uploaded in a single pipeline with no
# temporary files at any point:
#
#     dump | gzip -c | rclone rcat <remote>/<timestamp>/<database>.sql.gz
#
# Targets bash (4.x/5.x) with GNU coreutils on Ubuntu/Debian/RHEL-family
# Linux servers (verified: Ubuntu, Debian, Rocky Linux -- all ship both by
# default). Alpine and other busybox/musl-based distros ship neither: bash
# isn't installed by default, and busybox's `date` doesn't support the
# relative-date parsing (`date -d "-N months"`) that the tiered-retention
# monthly-window calculation depends on. `apk add bash coreutils` (or
# equivalent) fixes both if this ever needs to run there.
#
# See --help for usage.

set -eo pipefail

# --- Defaults (lowest precedence: overridden by .env, then by CLI flags) -----
DEFAULT_DRIVER=mysql
DEFAULT_HOST=127.0.0.1
DEFAULT_DATABASES=ALL
DEFAULT_RETENTION=30

DRY_RUN=0
QUIET=0
VERBOSE=0

STARTED_AT="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
ARCHIVES=()     # one JSON object per database, sent with the completion ping
FILTER_FILE=""  # tiered-retention temp file, removed by on_exit

# --- Logging -----------------------------------------------------------------
_ts() { date '+%Y-%m-%d %H:%M:%S'; }

log() {
    if [[ "$QUIET" == 1 ]]; then return 0; fi
    local line="[$(_ts)] $*"
    if [[ -n "${LOG:-}" ]]; then
        printf '%s\n' "$line" | tee -a "$LOG"
    else
        printf '%s\n' "$line"
    fi
}

err() {
    local line="[$(_ts)] ERROR: $*"
    if [[ -n "${LOG:-}" ]]; then
        printf '%s\n' "$line" | tee -a "$LOG" >&2
    else
        printf '%s\n' "$line" >&2
    fi
}

warn() {
    local line="[$(_ts)] WARNING: $*"
    if [[ -n "${LOG:-}" ]]; then
        printf '%s\n' "$line" | tee -a "$LOG" >&2
    else
        printf '%s\n' "$line" >&2
    fi
}

die() { err "$*"; exit 1; }

json_str() {
    local s="${1//\\/\\\\}"
    s="${s//\"/\\\"}"
    printf '"%s"' "$s"
}

# Human-readable byte count via numfmt, with a raw-bytes fallback.
format_size() {
    local b="$1"
    if [[ -z "$b" || ! "$b" =~ ^[0-9]+$ ]]; then
        printf 'unknown size'
        return 0
    fi
    if command -v numfmt >/dev/null 2>&1; then
        numfmt --to=iec --suffix=B "$b" 2>/dev/null || printf '%s B' "$b"
    else
        printf '%s B' "$b"
    fi
}

# --- Driver functions (each writes the dump to stdout) -----------------------
# Same flags as Forge's backup.sh, plus --no-tablespaces: since MySQL 8.0.21,
# dumping tablespace info needs the PROCESS privilege, so a least-privilege
# backup user fails without it. Laravel apps don't use tablespaces.
dump_mysql() {
    "$DUMP_BIN" "${MYSQL_ARGS[@]}" \
        --single-transaction --skip-lock-tables --routines --hex-blob \
        --no-tablespaces -B "$1"
}

# --clean --create emits DROP/CREATE DATABASE; --if-exists keeps the DROP from
# erroring when restoring onto a server that doesn't have the database yet.
dump_pgsql() {
    "$DUMP_BIN" "${PG_CONN[@]}" --clean --if-exists --create -F p "$1"
}

dump_db() {
    case "$DRIVER" in
        mysql|mariadb) dump_mysql "$1" ;;
        pgsql)         dump_pgsql "$1" ;;
    esac
}

# List databases on the server (system databases filtered by is_system_db / SQL).
enumerate_databases() {
    case "$DRIVER" in
        mysql|mariadb)
            "$CLIENT_BIN" "${MYSQL_ARGS[@]}" -N -e "SHOW DATABASES"
            ;;
        pgsql)
            local -a q=("${PG_CONN[@]}")
            # Without a service we connect to the default maintenance db; with a
            # service we let it choose the db (pg_database is visible from any).
            if [[ -z "$SERVICE" ]]; then q+=(--dbname=postgres); fi
            psql "${q[@]}" -At \
                 -c "SELECT datname FROM pg_database WHERE datistemplate = false AND datname <> 'postgres';"
            ;;
    esac
}

is_system_db() {
    case "$DRIVER" in
        mysql|mariadb)
            case "$1" in
                information_schema|performance_schema|sys|mysql) return 0 ;;
            esac
            ;;
    esac
    return 1
}

# --- Help --------------------------------------------------------------------
show_help() {
    cat <<'EOF'
db-backup — stream database backups directly to object storage via rclone.

USAGE
  db-backup [OPTIONS]

DATABASE OPTIONS
  -d, --driver <driver>       mysql | mariadb | pgsql (default: mysql)
  -h, --host <host>           default: 127.0.0.1
  -P, --port <port>           default: driver default
  -u, --user <user>           default: root (mysql/mariadb), postgres (pgsql)
  -p, --password <password>
      --login-path <name>     mysql/mariadb: read credentials from a named
                              mysql_config_editor login-path instead of -u/-p
      --service <name>        pgsql: connect via a ~/.pg_service.conf service
                              (secret in ~/.pgpass) instead of -u/-p
  -D, --databases <names>     Space-separated list, or ALL (default: ALL)

STORAGE OPTIONS
  -r, --primary <remote>      Required. e.g. hetzner:my-bucket/db-backups
  -R, --secondary <remote>    Optional. Synced from primary after dumps complete.

RETENTION OPTIONS
  --retention <days>          Default: 30. 0 = disabled. Ignored (with a
                              warning, if explicitly set) when any of
                              --hourly/--daily/--monthly below are used.
  --hourly <hours>            Tiered retention: keep every backup from the
                              last N hours. Default: 0 (disabled).
  --daily <days>              Beyond the hourly window, keep the most recent
                              backup per calendar day, for N days. Default: 0.
  --monthly <months>          Beyond the daily window, keep the most recent
                              backup per calendar month, for N months
                              (calendar-accurate). Default: 0.
                              Setting any of --hourly/--daily/--monthly (or
                              their env vars) -- even to 0 -- switches to
                              tiered retention; --hourly/--daily/--monthly all
                              0 is rejected, since it would delete every
                              backup including the one just made.
  Retention is skipped when any database fails to back up, so a failed run
  never causes older good backups to be deleted.

MONITORING OPTIONS
  --ping <url>                POST the outcome to <url> on every exit,
                              including failures. "{status}" in the URL is
                              replaced with the exit code (0 = success), e.g.
                              https://hc-ping.com/<uuid>/{status}
                              Form fields: status, host, timestamp, started_at,
                              finished_at, path, archives (JSON array of
                              {database, status, bytes|stage}).

OUTPUT OPTIONS
  -l, --log <file>            Append to log file in addition to stdout
  -n, --dry-run               Show what would run without executing
  -q, --quiet                 Suppress output except errors
  -v, --verbose               Pass verbose flag through to rclone

GENERAL OPTIONS
      --env <file>            Source a .env file (default: .env in current dir)
      --help                  Show help

ENVIRONMENT VARIABLES (CLI flags always take precedence)
  DB_DRIVER, DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, DB_NAMES, DB_LOGIN_PATH,
  DB_SERVICE, RCLONE_PRIMARY, RCLONE_SECONDARY, RETENTION_DAYS,
  RETENTION_HOURLY, RETENTION_DAILY, RETENTION_MONTHLY, LOG_FILE, PING_URL
  (pgsql also honours the standard PGSERVICE variable. Setting any of
  RETENTION_HOURLY/RETENTION_DAILY/RETENTION_MONTHLY switches to tiered
  retention; see RETENTION OPTIONS above.)

CREDENTIALS
  Like rclone remotes, credentials can live in a named store instead of flags:
    mysql/mariadb:
      mysql_config_editor set --login-path=prod --host=H --user=U --password
      db-backup --login-path prod -r hetzner:my-bucket/db-backups
    pgsql:
      # ~/.pg_service.conf -> [prod] host=H user=U dbname=postgres
      # ~/.pgpass (chmod 600) -> H:5432:*:U:secret
      db-backup --driver pgsql --service prod -r hetzner:my-bucket/db-backups
    pgsql on the same machine, no password at all (peer auth): connect over
    the Unix socket as the role matching your OS user. Needs a `local ...
    peer` line in pg_hba.conf (the Ubuntu/Debian default) and PostgreSQL 14+
    for pg_read_all_data:
      sudo -u postgres createuser forge    # skip if the role already exists
      sudo -u postgres psql -c 'GRANT pg_read_all_data TO forge'
      db-backup --driver pgsql --host /var/run/postgresql --user forge \
        -r hetzner:my-bucket/db-backups

RESTORE
  # Stream directly into MySQL without downloading
  rclone cat hetzner:my-bucket/db-backups/20250613020000/myapp.sql.gz \
    | gunzip | mysql -u root -p myapp

  # PostgreSQL: the dump drops and recreates the database itself, so connect
  # to a different one (e.g. postgres). Stop other connections to it first.
  rclone cat hetzner:my-bucket/db-backups/20250613020000/myapp.sql.gz \
    | gunzip | psql -U postgres -d postgres -v ON_ERROR_STOP=1

CRON
  # /etc/cron.d/db-backup -- flat retention, one daily run:
  0 2 * * * forge /usr/local/bin/db-backup --env /etc/backup/production.env --log /var/log/backup.log

  # Tiered retention needs only ONE schedule too -- hourly is enough, since
  # prune_tiered itself thins older backups down to daily/monthly granularity:
  0 * * * * forge /usr/local/bin/db-backup --env /etc/backup/production.env --log /var/log/backup.log --hourly 48 --daily 14 --monthly 6
EOF
}

# --- Argument parsing --------------------------------------------------------
need() { [[ "$2" -ge 2 ]] || die "Option '$1' requires a value"; }

if [[ $# -eq 0 ]]; then show_help; exit 0; fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        -d|--driver)     need "$1" $#; CLI_DRIVER="$2";     shift 2 ;;
        -h|--host)       need "$1" $#; CLI_HOST="$2";       shift 2 ;;
        -P|--port)       need "$1" $#; CLI_PORT="$2";       shift 2 ;;
        -u|--user)       need "$1" $#; CLI_USER="$2";       shift 2 ;;
        -p|--password)   need "$1" $#; CLI_PASSWORD="$2";   shift 2 ;;
        --login-path)    need "$1" $#; CLI_LOGIN_PATH="$2"; shift 2 ;;
        --service)       need "$1" $#; CLI_SERVICE="$2";    shift 2 ;;
        -D|--databases)  need "$1" $#; CLI_DATABASES="$2";  shift 2 ;;
        -r|--primary)    need "$1" $#; CLI_PRIMARY="$2";    shift 2 ;;
        -R|--secondary)  need "$1" $#; CLI_SECONDARY="$2";  shift 2 ;;
        --retention)     need "$1" $#; CLI_RETENTION="$2";  shift 2 ;;
        --hourly)        need "$1" $#; CLI_HOURLY="$2";      shift 2 ;;
        --daily)         need "$1" $#; CLI_DAILY="$2";       shift 2 ;;
        --monthly)       need "$1" $#; CLI_MONTHLY="$2";     shift 2 ;;
        -l|--log)        need "$1" $#; CLI_LOG="$2";        shift 2 ;;
        --ping)          need "$1" $#; CLI_PING="$2";       shift 2 ;;
        --env)           need "$1" $#; ENV_FILE="$2";       shift 2 ;;
        -n|--dry-run)    DRY_RUN=1; shift ;;
        -q|--quiet)      QUIET=1;   shift ;;
        -v|--verbose)    VERBOSE=1; shift ;;
        --help)          show_help; exit 0 ;;
        --)              shift; break ;;
        -*)              die "Unknown option: '$1' (try --help)" ;;
        *)               die "Unexpected argument: '$1' (try --help)" ;;
    esac
done

# --- Load .env (explicit --env, else .env in the invocation directory) -------
# CLI flags were captured into CLI_* above; .env is sourced now and resolved
# below so CLI always wins over env vars, which win over defaults.
if [[ -n "${ENV_FILE:-}" ]]; then
    [[ -f "$ENV_FILE" ]] || die "Env file not found: $ENV_FILE"
    set -a; . "$ENV_FILE"; set +a
elif [[ -f "$PWD/.env" ]]; then
    set -a; . "$PWD/.env"; set +a
fi

# --- Resolve configuration (CLI > env > default) -----------------------------
DRIVER="${CLI_DRIVER:-${DB_DRIVER:-$DEFAULT_DRIVER}}"
HOST="${CLI_HOST:-${DB_HOST:-$DEFAULT_HOST}}"
PORT="${CLI_PORT:-${DB_PORT:-}}"
DBUSER="${CLI_USER:-${DB_USER:-}}"
PASSWORD="${CLI_PASSWORD:-${DB_PASSWORD:-}}"
LOGIN_PATH="${CLI_LOGIN_PATH:-${DB_LOGIN_PATH:-}}"
SERVICE="${CLI_SERVICE:-${DB_SERVICE:-${PGSERVICE:-}}}"
DATABASES="${CLI_DATABASES:-${DB_NAMES:-$DEFAULT_DATABASES}}"

# Explicit (pre-default) connection params. In --login-path / --service mode the
# host/port/user/password come from the credential store; these still override
# individual fields when set.
HOST_EXPLICIT="${CLI_HOST:-${DB_HOST:-}}"
PORT_EXPLICIT="${CLI_PORT:-${DB_PORT:-}}"
USER_EXPLICIT="${CLI_USER:-${DB_USER:-}}"
PRIMARY="${CLI_PRIMARY:-${RCLONE_PRIMARY:-}}"
SECONDARY="${CLI_SECONDARY:-${RCLONE_SECONDARY:-}}"
RETENTION="${CLI_RETENTION:-${RETENTION_DAYS:-$DEFAULT_RETENTION}}"
LOG="${CLI_LOG:-${LOG_FILE:-}}"
PING_URL="${CLI_PING:-${PING_URL:-}}"

# Tiered ("grandfather-father-son") retention. Presence (not value) of any of
# these three -- flag or env var, even set to 0 -- switches into tiered mode,
# where the flat RETENTION above is ignored instead of combined with it.
TIER_MODE=0
if [[ -n "${CLI_HOURLY+x}" || -n "${CLI_DAILY+x}" || -n "${CLI_MONTHLY+x}" \
   || -n "${RETENTION_HOURLY+x}" || -n "${RETENTION_DAILY+x}" || -n "${RETENTION_MONTHLY+x}" ]]; then
    TIER_MODE=1
fi
HOURLY="${CLI_HOURLY:-${RETENTION_HOURLY:-0}}"
DAILY="${CLI_DAILY:-${RETENTION_DAILY:-0}}"
MONTHLY="${CLI_MONTHLY:-${RETENTION_MONTHLY:-0}}"

# --- Exit handler: cleanup + completion ping ---------------------------------
# Runs on every exit -- success, die(), or an unexpected error -- so the ping
# always reports the outcome (the same approach as Forge's backup.sh). Must not
# call exit or let a command fail, or it would change the script's exit code.
if [[ -n "$PING_URL" ]]; then
    command -v curl >/dev/null 2>&1 || die "curl not found in PATH (needed for --ping)"
fi

# shellcheck disable=SC2317  # invoked via trap
on_exit() {
    local rc="$1" url path="" archives
    if [[ -n "$FILTER_FILE" ]]; then rm -f "$FILTER_FILE"; fi
    [[ -n "$PING_URL" ]] || return 0

    if [[ "$DRY_RUN" == 1 ]]; then
        log "DRY RUN: would ping completion URL (status=$rc)"
        return 0
    fi

    url="${PING_URL//\{status\}/$rc}"
    if [[ -n "${TIMESTAMP:-}" ]]; then
        path="${PRIMARY}/${TIMESTAMP}"
        # A connection-string remote (":s3,secret_access_key=...:bucket") can
        # embed credentials; send only the path after the last colon.
        if [[ "$path" == *,* ]]; then path="${path##*:}"; fi
    fi
    archives="$(IFS=,; printf '[%s]' "${ARCHIVES[*]}")"

    log "Pinging completion URL (status=$rc)"
    curl -fsS -o /dev/null --max-time 30 --retry 3 \
        --data-urlencode "status=$rc" \
        --data-urlencode "host=$(hostname)" \
        --data-urlencode "timestamp=${TIMESTAMP:-}" \
        --data-urlencode "started_at=$STARTED_AT" \
        --data-urlencode "finished_at=$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
        --data-urlencode "path=$path" \
        --data-urlencode "archives=$archives" \
        "$url" || warn "Completion ping failed"
}
trap 'on_exit $?' EXIT

# --- Validate ----------------------------------------------------------------
case "$DRIVER" in
    mysql)   DUMP_BIN=mysqldump;    CLIENT_BIN=mysql ;;
    mariadb) DUMP_BIN=mariadb-dump; CLIENT_BIN=mariadb ;;
    pgsql)   DUMP_BIN=pg_dump;      CLIENT_BIN=psql ;;
    *)       die "Invalid driver: '$DRIVER' (expected mysql, mariadb, or pgsql)" ;;
esac

if [[ -z "$PORT" ]]; then
    case "$DRIVER" in
        pgsql) PORT=5432 ;;
        *)     PORT=3306 ;;
    esac
fi
if [[ -z "$DBUSER" ]]; then
    case "$DRIVER" in
        pgsql) DBUSER=postgres ;;
        *)     DBUSER=root ;;
    esac
fi

if [[ -n "$LOGIN_PATH" && "$DRIVER" == pgsql ]]; then
    die "--login-path is only valid for mysql/mariadb (use --service for pgsql)"
fi
if [[ -n "$SERVICE" && "$DRIVER" != pgsql ]]; then
    die "--service is only valid for pgsql (use --login-path for mysql/mariadb)"
fi

[[ -n "$PRIMARY" ]] || die "Missing required --primary (or RCLONE_PRIMARY)"
[[ "$RETENTION" =~ ^[0-9]+$ ]] || die "Invalid --retention: '$RETENTION' (expected a non-negative integer)"

[[ "$HOURLY" =~ ^[0-9]+$ ]]  || die "Invalid --hourly: '$HOURLY' (expected a non-negative integer)"
[[ "$DAILY" =~ ^[0-9]+$ ]]   || die "Invalid --daily: '$DAILY' (expected a non-negative integer)"
[[ "$MONTHLY" =~ ^[0-9]+$ ]] || die "Invalid --monthly: '$MONTHLY' (expected a non-negative integer)"
# Force base-10: these feed arithmetic below, where a leading zero (e.g. "08")
# would otherwise be parsed as octal by bash and error out (or silently change
# value, e.g. "07" -> 7 is fine but "08"/"09" are invalid octal digits).
HOURLY=$((10#$HOURLY))
DAILY=$((10#$DAILY))
MONTHLY=$((10#$MONTHLY))

if [[ "$TIER_MODE" == 1 && "$HOURLY" -eq 0 && "$DAILY" -eq 0 && "$MONTHLY" -eq 0 ]]; then
    die "Tiered retention active but --hourly/--daily/--monthly are all 0 (unlike --retention 0, this would delete every backup, including the one just made)"
fi

command -v rclone     >/dev/null 2>&1 || die "rclone not found in PATH"
command -v gzip       >/dev/null 2>&1 || die "gzip not found in PATH"
command -v "$DUMP_BIN" >/dev/null 2>&1 || die "$DUMP_BIN not found in PATH"

PRIMARY="${PRIMARY%/}"
if [[ -n "$SECONDARY" ]]; then SECONDARY="${SECONDARY%/}"; fi

# --- Build per-driver connection args + password env -------------------------
# With --login-path (mysql/mariadb) or --service (pgsql) the credentials live in
# the client's own named store (~/.mylogin.cnf, ~/.pg_service.conf + ~/.pgpass) —
# the rclone-remote equivalent. Explicit --host/--port/--user still override.
MYSQL_ARGS=()
PG_CONN=()
case "$DRIVER" in
    mysql|mariadb)
        if [[ -n "$LOGIN_PATH" ]]; then
            MYSQL_ARGS+=(--login-path="$LOGIN_PATH")
            if [[ -n "$HOST_EXPLICIT" ]]; then MYSQL_ARGS+=(--host="$HOST_EXPLICIT"); fi
            if [[ -n "$PORT_EXPLICIT" ]]; then MYSQL_ARGS+=(--port="$PORT_EXPLICIT"); fi
            if [[ -n "$USER_EXPLICIT" ]]; then MYSQL_ARGS+=(--user="$USER_EXPLICIT"); fi
        else
            MYSQL_ARGS+=(--host="$HOST" --port="$PORT" --user="$DBUSER")
        fi
        ;;
    pgsql)
        if [[ -n "$SERVICE" ]]; then
            export PGSERVICE="$SERVICE"
            if [[ -n "$HOST_EXPLICIT" ]]; then PG_CONN+=(--host="$HOST_EXPLICIT"); fi
            if [[ -n "$PORT_EXPLICIT" ]]; then PG_CONN+=(--port="$PORT_EXPLICIT"); fi
            if [[ -n "$USER_EXPLICIT" ]]; then PG_CONN+=(--username="$USER_EXPLICIT"); fi
        else
            PG_CONN+=(--host="$HOST" --port="$PORT" --username="$DBUSER")
        fi
        ;;
esac

# Password env. PASSWORD is only set when explicitly provided (no default), so in
# login-path / service mode this stays unset and the store's password is used.
if [[ -n "$PASSWORD" ]]; then
    case "$DRIVER" in
        mysql|mariadb) export MYSQL_PWD="$PASSWORD" ;;
        pgsql)         export PGPASSWORD="$PASSWORD" ;;
    esac
fi

RCLONE_OPTS=()
if [[ "$VERBOSE" == 1 ]]; then RCLONE_OPTS+=(-v); fi

# --- Build the list of databases to back up ----------------------------------
DB_LIST=()
if [[ "$DATABASES" == [Aa][Ll][Ll] ]]; then
    command -v "$CLIENT_BIN" >/dev/null 2>&1 \
        || die "$CLIENT_BIN not found in PATH (needed to enumerate databases)"
    if [[ -n "$LOGIN_PATH" ]]; then
        log "Enumerating databases via login-path '$LOGIN_PATH'"
    elif [[ -n "$SERVICE" ]]; then
        log "Enumerating databases via service '$SERVICE'"
    else
        log "Enumerating databases on $DRIVER server $HOST:$PORT"
    fi
    set +e
    _raw="$(enumerate_databases)"
    _rc=$?
    set -e
    [[ $_rc -eq 0 ]] || die "Failed to enumerate databases from server (exit $_rc)"
    while IFS= read -r _name; do
        [[ -n "$_name" ]] || continue
        if is_system_db "$_name"; then continue; fi
        DB_LIST+=("$_name")
    done <<< "$_raw"
else
    read -r -a DB_LIST <<< "$DATABASES"
fi

[[ ${#DB_LIST[@]} -gt 0 ]] || die "No databases to back up (empty list after enumeration)"

# --- Back up one database: dump | gzip -c | rclone rcat ----------------------
TIMESTAMP="$(date '+%Y%m%d%H%M%S')"
FAILED=0
RESULT_LINES=()

backup_database() {
    local db="$1"
    local dest="${PRIMARY}/${TIMESTAMP}/${db}.sql.gz"
    local -a st
    local bytes human stage=""

    if [[ "$DRY_RUN" == 1 ]]; then
        log "DRY RUN: would back up '$db' -> $dest"
        RESULT_LINES+=("$db  DRY-RUN  -> $dest")
        return 0
    fi

    log "Backing up '$db' -> $dest"

    set +e
    dump_db "$db" | gzip -c | rclone rcat "${RCLONE_OPTS[@]}" "$dest"
    st=("${PIPESTATUS[@]}")
    set -e

    if [[ "${st[0]}" -ne 0 ]]; then
        stage=dump;   err "'$db': dump stage ($DUMP_BIN) failed (exit ${st[0]})"
    elif [[ "${st[1]}" -ne 0 ]]; then
        stage=gzip;   err "'$db': gzip stage failed (exit ${st[1]})"
    elif [[ "${st[2]}" -ne 0 ]]; then
        stage=upload; err "'$db': upload stage (rclone rcat) failed (exit ${st[2]})"
    fi

    if [[ -n "$stage" ]]; then
        # When the dump dies mid-way, gzip still closes a valid stream and
        # rcat completes the upload, leaving a truncated file that looks like
        # a good backup. Remove it (an upload failure leaves nothing behind).
        if [[ "$stage" != upload ]]; then
            rclone deletefile "${RCLONE_OPTS[@]}" "$dest" \
                || warn "'$db': could not remove partial upload $dest"
        fi
        FAILED=1
        RESULT_LINES+=("$db  FAILED($stage)  -")
        ARCHIVES+=("{\"database\":$(json_str "$db"),\"status\":\"failed\",\"stage\":\"$stage\"}")
        return 0
    fi

    bytes="$(rclone size --json "$dest" 2>/dev/null \
        | grep -o '"bytes":[0-9]*' | head -n1 | cut -d: -f2 || true)"
    human="$(format_size "${bytes:-0}")"
    log "OK: '$db' ($human compressed)"
    RESULT_LINES+=("$db  OK  $human")
    ARCHIVES+=("{\"database\":$(json_str "$db"),\"status\":\"ok\",\"bytes\":${bytes:-null}}")
    return 0
}

# --- Tiered ("grandfather-father-son") retention ------------------------------
# Parse a TIMESTAMP-formatted folder name (this script's own YYYYMMDDHHMMSS
# format) into epoch seconds. Deliberately does NOT use rclone's mtime metadata
# (--min-age / lsjson ModTime): on S3-compatible backends like R2, "directories"
# are synthetic common-prefixes with unreliable/fabricated mtimes, whereas the
# epoch is fully recoverable from the name this script itself writes.
ts_to_epoch() {
    local ts="$1"
    date -d "${ts:0:4}-${ts:4:2}-${ts:6:2} ${ts:8:2}:${ts:10:2}:${ts:12:2}" +%s
}

# Keep every backup within the hourly window; beyond that, keep only the most
# recent backup per calendar day (daily window), then per calendar month
# (monthly window); delete anything older than all three. Windows are expected
# to nest (hourly <= daily <= monthly) for intuitive GFS behaviour, but this
# isn't enforced -- an omitted/zero tier just has zero width, so anything past
# the previous tier's cutoff falls straight through to the next check.
prune_tiered() {
    local now cutoff_hourly cutoff_daily cutoff_monthly
    local -a folders valid to_delete
    local entry ts epoch daykey monthkey
    local _raw _rc _erc _prc
    local kept_hourly=0 kept_daily=0 kept_monthly=0 deleted=0
    local -A day_max=() month_max=() zone_of=() epoch_of=()

    now="$(date +%s)"
    cutoff_hourly=$((now - HOURLY * 3600))
    cutoff_daily=$((now - DAILY * 86400))
    cutoff_monthly="$(date -d "-${MONTHLY} months" +%s)"

    # Command substitution (not process substitution) so $? reflects rclone's
    # exit code, not the reading loop's -- mirrors enumerate_databases above.
    set +e
    _raw="$(rclone lsf "$PRIMARY" --dirs-only "${RCLONE_OPTS[@]}")"
    _rc=$?
    set -e
    if [[ $_rc -ne 0 ]]; then
        err "Failed to list $PRIMARY for tiered retention (exit $_rc)"
        FAILED=1
        return 0
    fi

    folders=()
    while IFS= read -r entry; do
        [[ -n "$entry" ]] || continue
        folders+=("$entry")
    done <<< "$_raw"

    # Pass 1: validate + classify each folder into a zone, tracking the newest
    # epoch seen per day/month bucket so pass 2 can keep only the most recent.
    valid=()
    for entry in "${folders[@]}"; do
        ts="${entry%/}"
        if [[ ! "$ts" =~ ^[0-9]{14}$ ]]; then
            warn "Skipping unrecognised entry in $PRIMARY: '$entry'"
            continue
        fi

        set +e
        epoch="$(ts_to_epoch "$ts")"
        _erc=$?
        set -e
        if [[ $_erc -ne 0 || -z "$epoch" ]]; then
            warn "Skipping folder with unparseable timestamp: '$ts'"
            continue
        fi

        valid+=("$ts")
        epoch_of["$ts"]="$epoch"

        if [[ "$epoch" -ge "$cutoff_hourly" ]]; then
            zone_of["$ts"]=hourly
        elif [[ "$epoch" -ge "$cutoff_daily" ]]; then
            zone_of["$ts"]=daily
            daykey="${ts:0:8}"
            if [[ -z "${day_max[$daykey]:-}" || "$epoch" -gt "${day_max[$daykey]}" ]]; then
                day_max["$daykey"]="$epoch"
            fi
        elif [[ "$epoch" -ge "$cutoff_monthly" ]]; then
            zone_of["$ts"]=monthly
            monthkey="${ts:0:6}"
            if [[ -z "${month_max[$monthkey]:-}" || "$epoch" -gt "${month_max[$monthkey]}" ]]; then
                month_max["$monthkey"]="$epoch"
            fi
        else
            zone_of["$ts"]=expired
        fi
    done

    # Pass 2: keep the winner of each bucket (or everything hourly); collect the rest.
    to_delete=()
    for ts in "${valid[@]}"; do
        epoch="${epoch_of[$ts]}"
        case "${zone_of[$ts]}" in
            hourly)
                kept_hourly=$((kept_hourly + 1))
                continue
                ;;
            daily)
                daykey="${ts:0:8}"
                if [[ "$epoch" -eq "${day_max[$daykey]}" ]]; then
                    kept_daily=$((kept_daily + 1))
                    continue
                fi
                ;;
            monthly)
                monthkey="${ts:0:6}"
                if [[ "$epoch" -eq "${month_max[$monthkey]}" ]]; then
                    kept_monthly=$((kept_monthly + 1))
                    continue
                fi
                ;;
            expired) ;;
        esac
        to_delete+=("$ts")
    done

    # Delete everything in one rclone call rather than one purge per folder.
    # rclone purge doesn't obey filters, so this uses `delete --include-from`
    # instead. This also means the (harmless) per-call GetBucketVersioning
    # probe some S3-compatible backends 403 on -- R2 has no versioning
    # concept, so rclone falls back to "assume unversioned" and proceeds --
    # only happens once per run instead of once per deleted folder.
    if [[ "$DRY_RUN" == 1 ]]; then
        for ts in "${to_delete[@]}"; do
            log "DRY RUN: would purge $PRIMARY/$ts"
        done
        deleted=${#to_delete[@]}
    elif [[ ${#to_delete[@]} -gt 0 ]]; then
        # on_exit also removes FILTER_FILE, covering a kill/timeout while
        # rclone is mid-run, not just normal completion.
        FILTER_FILE="$(mktemp)"
        printf '%s/**\n' "${to_delete[@]}" > "$FILTER_FILE"
        set +e
        rclone delete "$PRIMARY" --include-from "$FILTER_FILE" --rmdirs "${RCLONE_OPTS[@]}"
        _prc=$?
        set -e
        rm -f "$FILTER_FILE"
        FILTER_FILE=""
        if [[ $_prc -ne 0 ]]; then
            err "Failed to purge ${#to_delete[@]} expired backup folder(s) (exit $_prc)"
            FAILED=1
        else
            deleted=${#to_delete[@]}
        fi
    fi

    local verb="deleted"
    [[ "$DRY_RUN" == 1 ]] && verb="would delete"
    log "Tiered retention: kept ${kept_hourly} hourly / ${kept_daily} daily / ${kept_monthly} monthly; $verb ${deleted}"
}

# --- Run ---------------------------------------------------------------------
log "=== db-backup starting (driver=$DRIVER, timestamp=$TIMESTAMP) ==="
log "Databases: ${DB_LIST[*]}"

for db in "${DB_LIST[@]}"; do
    backup_database "$db"
done

# --- Retention (prune primary first so the deletions propagate via sync) -----
# A failed run would otherwise count as the newest backup (tiered: the day's
# keeper) and push older, complete backups out of the window.
if [[ "$FAILED" -eq 1 ]]; then
    warn "Skipping retention because a backup failed -- older backups are kept"
elif [[ "$TIER_MODE" == 1 ]]; then
    if [[ -n "${CLI_RETENTION+x}" || -n "${RETENTION_DAYS+x}" ]]; then
        warn "Tiered retention active (--hourly/--daily/--monthly); ignoring --retention/RETENTION_DAYS ($RETENTION)"
    fi
    prune_tiered
else
    if [[ "$RETENTION" -gt 0 ]]; then
        if [[ "$DRY_RUN" == 1 ]]; then
            log "DRY RUN: would prune files older than ${RETENTION}d from $PRIMARY"
        else
            log "Pruning files older than ${RETENTION}d from primary"
            set +e
            rclone delete "$PRIMARY" --min-age "${RETENTION}d" --rmdirs "${RCLONE_OPTS[@]}"
            _prc=$?
            set -e
            if [[ $_prc -ne 0 ]]; then
                err "Retention prune failed (exit $_prc)"
                FAILED=1
            fi
        fi
    else
        log "Retention disabled (--retention 0)"
    fi
fi

# --- Secondary sync (warning-only; does not affect exit code) ----------------
if [[ -n "$SECONDARY" ]]; then
    if [[ "$DRY_RUN" == 1 ]]; then
        log "DRY RUN: would sync $PRIMARY -> $SECONDARY"
    else
        log "Syncing primary -> secondary ($SECONDARY)"
        set +e
        rclone sync "$PRIMARY" "$SECONDARY" "${RCLONE_OPTS[@]}"
        _src=$?
        set -e
        if [[ $_src -ne 0 ]]; then
            warn "Secondary sync failed (exit $_src) — primary backup unaffected"
        else
            log "Secondary sync complete"
        fi
    fi
fi

# --- Summary -----------------------------------------------------------------
log "----- Summary ($TIMESTAMP) -----"
for line in "${RESULT_LINES[@]}"; do
    log "  $line"
done

if [[ "$FAILED" -eq 1 ]]; then
    err "Backup completed with FAILURES"
    log "Overall: FAILED"
    exit 1
fi
log "Overall: OK"
exit 0
